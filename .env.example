# ============================================================
# SMARTCREDIT - CONFIGURATION
# ============================================================

APP_ENV=production

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,smartcredit-backend

# ------------------------------------------------------------
# Super administrateur automatique (Render sans Shell)
# ------------------------------------------------------------

# Créé au démarrage s'il n'existe pas. Laissez vide pour désactiver.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_FIRST_NAME=
DJANGO_SUPERUSER_LAST_NAME=
# Passer à true ponctuellement pour réinitialiser le mot de passe.
DJANGO_SUPERUSER_RESET_PASSWORD=false

# ------------------------------------------------------------
# Base de données PostgreSQL
# ------------------------------------------------------------

# Render fournit automatiquement DATABASE_URL. Si cette variable est
# définie, elle est prioritaire sur les variables DB_* ci-dessous.
DATABASE_URL=

DB_NAME=smartcredit_db
DB_USER=smartcredit_user
DB_PASSWORD=smartcredit_dev_password
DB_HOST=smartcredit-db
DB_PORT=5432

# ------------------------------------------------------------
# Machine Learning
# ------------------------------------------------------------

MODEL_PATH=/app/models/gradient_boosting_final.joblib
RISK_THRESHOLD_MEDIUM=0.30
RISK_THRESHOLD_HIGH=0.59

# ------------------------------------------------------------
# Authentification JWT
# ------------------------------------------------------------

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ------------------------------------------------------------
# CORS / CSRF (application frontend séparée)
# ------------------------------------------------------------

CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------
# Gunicorn
# ------------------------------------------------------------

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

LOG_LEVEL=INFO
